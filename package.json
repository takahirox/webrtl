{
  "name": "webrtl",
  "private": true,
  "scripts": {
    "build:demo": "python3 build_site.py",
    "test:local": "playwright test",
    "test:demo": "npm run build:demo && playwright test --config=playwright.static.config.js",
    "test:demo:built": "playwright test --config=playwright.static.config.js",
    "test:unit": "python3 -m unittest discover -s tests -v && node --test tests/*.test.cjs",
    "test:pages": "playwright test --config=playwright.pages.config.js",
    "test": "npm run test:unit && npm run test:local && npm run test:demo"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@yowasp/clang": "22.0.0-git20542-10",
    "@yowasp/yosys": "0.70.1258"
  }
}
